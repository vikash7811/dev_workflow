#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=dev-common
source "$SELF_DIR/dev-common"

REPO=""
PROFILE=""
FIX=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO="$2"; shift 2 ;;
    --profile) PROFILE="$2"; shift 2 ;;
    --check) FIX=0; shift ;;
    -h|--help)
      echo "Usage: dev-hygiene [--repo PATH] [--profile NAME] [--check]"
      exit 0 ;;
    *) dev_die "unknown argument: $1" ;;
  esac
done

dev_load_profile "$PROFILE"
ROOT="$(dev_resolve_repo "$REPO")"
export PYTHONDONTWRITEBYTECODE=1

dev_section "Python caches"
if [[ "$FIX" -eq 1 ]]; then
  dev_clean_python_cache "$ROOT"
fi

if find "$ROOT" -path '*/.git' -prune -o \
     \( -type d -name __pycache__ -o -type f -name '*.pyc' \) -print -quit |
   grep -q .; then
  dev_die "Python cache remains in source tree"
fi
echo "PASS"

dev_section "Git executable semantics"
dev_check_git_exec_semantics "$ROOT"
echo "PASS"

dev_section "Whitespace"
git -C "$ROOT" diff --check
git -C "$ROOT" diff --cached --check
echo "PASS"
