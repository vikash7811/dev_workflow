#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SELF_DIR/dev-common"

usage() {
  cat <<'USAGE'
Configure per-user Git identities used by dev-workflow.

Usage:
  dev-git-config set NAME --author-name TEXT --author-email EMAIL \
    --ssh-alias ALIAS --ssh-host HOST [--ssh-key PATH] \
    [--ssh-user USER] [--remote NAME]
  dev-git-config use NAME
  dev-git-config show [NAME]
  dev-git-config list
  dev-git-config clear
  dev-git-config delete NAME
  dev-git-config ssh-snippet [NAME]

Examples:
  dev-git-config set personal \
    --author-name "Jane Developer" \
    --author-email jane@example.com \
    --ssh-alias github-personal \
    --ssh-host github.com \
    --ssh-key ~/.ssh/id_ed25519_personal
  dev-git-config use personal
  dev-git-config show

Identity files are stored outside project repositories under:
  ${XDG_CONFIG_HOME:-$HOME/.config}/dev-workflow/git-profiles/
USAGE
}

write_profile() {
  local name="$1" author_name="$2" author_email="$3" ssh_alias="$4"
  local ssh_host="$5" ssh_key="$6" ssh_user="$7" remote="$8"
  local dir path tmp
  dir="$(dev_git_profiles_dir)"
  path="$dir/$name.conf"
  mkdir -p "$dir"
  tmp="${path}.tmp.$$"
  {
    echo '# Generated by dev-git-config. Stored outside project repositories.'
    printf 'DEV_GIT_AUTHOR_NAME=%q\n' "$author_name"
    printf 'DEV_GIT_AUTHOR_EMAIL=%q\n' "$author_email"
    printf 'DEV_GIT_SSH_ALIAS=%q\n' "$ssh_alias"
    printf 'DEV_GIT_SSH_HOST=%q\n' "$ssh_host"
    printf 'DEV_GIT_SSH_USER=%q\n' "$ssh_user"
    printf 'DEV_GIT_SSH_KEY=%q\n' "$ssh_key"
    printf 'DEV_GIT_REMOTE=%q\n' "$remote"
  } > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$path"
  echo "Saved Git identity profile: $name"
  echo "Path: $path"
}

show_profile() {
  local name="$1"
  dev_load_git_profile "$name"
  echo "Git profile : $name"
  echo "Git author  : ${DEV_GIT_AUTHOR_NAME} <${DEV_GIT_AUTHOR_EMAIL}>"
  echo "SSH alias   : ${DEV_GIT_SSH_ALIAS}"
  echo "SSH host    : ${DEV_GIT_SSH_HOST}"
  echo "SSH user    : ${DEV_GIT_SSH_USER:-git}"
  echo "SSH key     : ${DEV_GIT_SSH_KEY:-<agent/default>}"
  echo "Git remote  : ${DEV_GIT_REMOTE:-origin}"
}

ssh_snippet() {
  local name="$1" key
  dev_load_git_profile "$name"
  key="$(dev_expand_user_path "${DEV_GIT_SSH_KEY:-}")"
  cat <<EOF_SNIPPET
Host ${DEV_GIT_SSH_ALIAS}
    HostName ${DEV_GIT_SSH_HOST}
    User ${DEV_GIT_SSH_USER:-git}
EOF_SNIPPET
  if [[ -n "$key" ]]; then
    printf '    IdentityFile %s\n' "$key"
    echo '    IdentitiesOnly yes'
  fi
}

cmd="${1:-}"
case "$cmd" in
  -h|--help|"")
    usage
    exit 0
    ;;
  set)
    [[ $# -ge 2 ]] || dev_die "usage: dev-git-config set NAME [options]"
    name="$2"; shift 2
    [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || dev_die "invalid profile name: $name"
    author_name=""; author_email=""; ssh_alias=""; ssh_host=""; ssh_key=""; ssh_user="git"; remote="origin"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --author-name) author_name="$2"; shift 2 ;;
        --author-email) author_email="$2"; shift 2 ;;
        --ssh-alias) ssh_alias="$2"; shift 2 ;;
        --ssh-host) ssh_host="$2"; shift 2 ;;
        --ssh-key) ssh_key="$2"; shift 2 ;;
        --ssh-user) ssh_user="$2"; shift 2 ;;
        --remote) remote="$2"; shift 2 ;;
        *) dev_die "unknown argument: $1" ;;
      esac
    done
    [[ -n "$author_name" ]] || dev_die "--author-name required"
    [[ -n "$author_email" ]] || dev_die "--author-email required"
    [[ "$author_email" == *@* ]] || dev_die "--author-email does not look valid: $author_email"
    [[ -n "$ssh_alias" ]] || dev_die "--ssh-alias required"
    [[ -n "$ssh_host" ]] || dev_die "--ssh-host required"
    [[ -n "$remote" ]] || dev_die "--remote cannot be empty"
    write_profile "$name" "$author_name" "$author_email" "$ssh_alias" "$ssh_host" "$ssh_key" "$ssh_user" "$remote"
    ;;
  use)
    [[ $# -eq 2 ]] || dev_die "usage: dev-git-config use NAME"
    dev_set_active_git_profile "$2"
    echo "Active Git identity profile: $2"
    ;;
  show)
    [[ $# -le 2 ]] || dev_die "usage: dev-git-config show [NAME]"
    name="${2:-$(dev_get_active_git_profile 2>/dev/null || true)}"
    [[ -n "$name" ]] || dev_die "no active Git identity profile; use 'dev-git-config list' or specify a name"
    show_profile "$name"
    ;;
  list)
    [[ $# -eq 1 ]] || dev_die "usage: dev-git-config list"
    dir="$(dev_git_profiles_dir)"
    active="$(dev_get_active_git_profile 2>/dev/null || true)"
    shopt -s nullglob
    profiles=("$dir"/*.conf)
    if [[ "${#profiles[@]}" -eq 0 ]]; then
      echo "No Git identity profiles configured."
      echo "Use: dev-git-config set NAME ..."
      exit 0
    fi
    for path in "${profiles[@]}"; do
      name="$(basename "$path" .conf)"
      if [[ "$name" == "$active" ]]; then printf '* %s\n' "$name"; else printf '  %s\n' "$name"; fi
    done
    ;;
  clear)
    [[ $# -eq 1 ]] || dev_die "usage: dev-git-config clear"
    old="$(dev_get_active_git_profile 2>/dev/null || true)"
    dev_clear_active_git_profile
    if [[ -n "$old" ]]; then echo "Cleared active Git identity profile: $old"; else echo "No active Git identity profile was selected."; fi
    ;;
  delete)
    [[ $# -eq 2 ]] || dev_die "usage: dev-git-config delete NAME"
    path="$(dev_git_profile_path "$2")" || dev_die "Git identity profile not found: $2"
    active="$(dev_get_active_git_profile 2>/dev/null || true)"
    [[ "$active" != "$2" ]] || dev_clear_active_git_profile
    rm -f "$path"
    echo "Deleted Git identity profile: $2"
    ;;
  ssh-snippet)
    [[ $# -le 2 ]] || dev_die "usage: dev-git-config ssh-snippet [NAME]"
    name="${2:-$(dev_get_active_git_profile 2>/dev/null || true)}"
    [[ -n "$name" ]] || dev_die "no active Git identity profile"
    ssh_snippet "$name"
    ;;
  *)
    dev_die "unknown command: $cmd"
    ;;
esac
