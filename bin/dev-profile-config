#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SELF_DIR/dev-common"

usage() {
  cat <<'USAGE'
Configure per-user project profiles used by dev-use and other dev-* commands.

Profiles are stored outside the dev-workflow repository under:
  ${XDG_CONFIG_HOME:-$HOME/.config}/dev-workflow/profiles/

Usage:
  dev-profile-config set NAME --repo PATH [options]
  dev-profile-config show NAME
  dev-profile-config list
  dev-profile-config delete NAME

Set options:
  --repo PATH             Project Git repository (required for set)
  --workspace PATH        ROS workspace; omit for auto-detection
  --ros-version 1|2|auto  Pin ROS major version or leave automatic
  --ros-setup PATH        Pin setup.bash, e.g. /opt/ros/humble/setup.bash
  --ros-package NAME      Single ROS package
  --ros-packages "A B"    Multiple ROS packages
  --builder NAME          auto, catkin, catkin_make, or colcon
  --git-profile NAME      Expected user Git identity profile
  --docker-image IMAGE    Optional ROS1 Docker reproduction image
  --clear FIELD           Clear an optional field. FIELD is one of:
                          workspace, ros-version, ros-setup, ros-package,
                          ros-packages, builder, git-profile, docker-image

Examples:
  dev-profile-config set ros1_project \
    --repo ~/catkin_ws/src/my_project \
    --workspace ~/catkin_ws \
    --ros-version 1 \
    --ros-setup /opt/ros/noetic/setup.bash

  dev-profile-config set ros2_project \
    --repo ~/ros2_ws/src/my_project \
    --workspace ~/ros2_ws \
    --ros-version 2 \
    --ros-setup /opt/ros/humble/setup.bash \
    --git-profile personal

  dev-profile-config list
  dev-profile-config show ros2_project
  dev-use ros2_project
USAGE
}

quote_shell() {
  printf '%q' "$1"
}

validate_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] ||
    dev_die "invalid profile name '$1' (use letters, numbers, dot, underscore, or dash)"
}

profile_file() {
  local name="$1"
  printf '%s/%s.conf\n' "$(dev_project_profiles_dir)" "$name"
}

load_existing() {
  local file="$1"
  DEV_REPO=""
  DEV_ROS_WORKSPACE=""
  DEV_ROS_VERSION=""
  DEV_ROS_SETUP=""
  DEV_ROS_PACKAGE=""
  DEV_ROS_PACKAGES=""
  DEV_ROS_BUILDER=""
  DEV_GIT_PROFILE=""
  DEV_DOCKER_IMAGE=""
  if [[ -f "$file" ]]; then
    # shellcheck disable=SC1090
    source "$file"
  fi
}

write_profile() {
  local file="$1" dir tmp
  dir="$(dirname "$file")"
  mkdir -p "$dir"
  tmp="${file}.tmp.$$"
  {
    echo '# Generated by dev-profile-config. User-local; do not commit to dev-workflow.'
    printf 'DEV_REPO='; quote_shell "$DEV_REPO"; echo
    [[ -z "$DEV_ROS_WORKSPACE" ]] || { printf 'DEV_ROS_WORKSPACE='; quote_shell "$DEV_ROS_WORKSPACE"; echo; }
    [[ -z "$DEV_ROS_VERSION" ]] || { printf 'DEV_ROS_VERSION='; quote_shell "$DEV_ROS_VERSION"; echo; }
    [[ -z "$DEV_ROS_SETUP" ]] || { printf 'DEV_ROS_SETUP='; quote_shell "$DEV_ROS_SETUP"; echo; }
    [[ -z "$DEV_ROS_PACKAGE" ]] || { printf 'DEV_ROS_PACKAGE='; quote_shell "$DEV_ROS_PACKAGE"; echo; }
    [[ -z "$DEV_ROS_PACKAGES" ]] || { printf 'DEV_ROS_PACKAGES='; quote_shell "$DEV_ROS_PACKAGES"; echo; }
    [[ -z "$DEV_ROS_BUILDER" ]] || { printf 'DEV_ROS_BUILDER='; quote_shell "$DEV_ROS_BUILDER"; echo; }
    [[ -z "$DEV_GIT_PROFILE" ]] || { printf 'DEV_GIT_PROFILE='; quote_shell "$DEV_GIT_PROFILE"; echo; }
    [[ -z "$DEV_DOCKER_IMAGE" ]] || { printf 'DEV_DOCKER_IMAGE='; quote_shell "$DEV_DOCKER_IMAGE"; echo; }
  } > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
}

show_profile() {
  local name="$1" file
  file="$(profile_file "$name")"
  [[ -f "$file" ]] || dev_die "user project profile not found: $name"
  load_existing "$file"
  echo "Profile    : $name"
  echo "File       : $file"
  echo "Repository : ${DEV_REPO:-<unset>}"
  echo "Workspace  : ${DEV_ROS_WORKSPACE:-<auto-detect>}"
  echo "ROS version: ${DEV_ROS_VERSION:-auto}"
  echo "ROS setup  : ${DEV_ROS_SETUP:-<auto-detect>}"
  echo "ROS package: ${DEV_ROS_PACKAGES:-${DEV_ROS_PACKAGE:-<auto-detect>}}"
  echo "Builder    : ${DEV_ROS_BUILDER:-auto}"
  echo "Git profile: ${DEV_GIT_PROFILE:-<active user identity>}"
  echo "Docker image: ${DEV_DOCKER_IMAGE:-<unset>}"
}

cmd="${1:-}"
case "$cmd" in
  -h|--help|"")
    usage
    exit 0
    ;;
  list)
    dir="$(dev_project_profiles_dir)"
    shopt -s nullglob
    files=("$dir"/*.conf)
    shopt -u nullglob
    if [[ ${#files[@]} -eq 0 ]]; then
      echo "No user project profiles found in: $dir"
      exit 0
    fi
    active="$(dev_get_active_profile 2>/dev/null || true)"
    for file in "${files[@]}"; do
      name="$(basename "$file" .conf)"
      if [[ "$name" == "$active" ]]; then
        printf '* %s\n' "$name"
      else
        printf '  %s\n' "$name"
      fi
    done
    ;;
  show)
    [[ $# -eq 2 ]] || dev_die "usage: dev-profile-config show NAME"
    validate_name "$2"
    show_profile "$2"
    ;;
  delete)
    [[ $# -eq 2 ]] || dev_die "usage: dev-profile-config delete NAME"
    validate_name "$2"
    file="$(profile_file "$2")"
    [[ -f "$file" ]] || dev_die "user project profile not found: $2"
    rm -f "$file"
    if [[ "$(dev_get_active_profile 2>/dev/null || true)" == "$2" ]]; then
      dev_clear_active_profile
      echo "Deleted user project profile and cleared active selection: $2"
    else
      echo "Deleted user project profile: $2"
    fi
    ;;
  set)
    [[ $# -ge 2 ]] || dev_die "usage: dev-profile-config set NAME --repo PATH [options]"
    name="$2"
    validate_name "$name"
    shift 2
    file="$(profile_file "$name")"
    load_existing "$file"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --repo) DEV_REPO="${2:-}"; shift 2 ;;
        --workspace) DEV_ROS_WORKSPACE="${2:-}"; shift 2 ;;
        --ros-version)
          value="${2:-}"
          case "$value" in
            1|2) DEV_ROS_VERSION="$value" ;;
            auto) DEV_ROS_VERSION="" ;;
            *) dev_die "--ros-version must be 1, 2, or auto" ;;
          esac
          shift 2
          ;;
        --ros-setup) DEV_ROS_SETUP="${2:-}"; shift 2 ;;
        --ros-package) DEV_ROS_PACKAGE="${2:-}"; DEV_ROS_PACKAGES=""; shift 2 ;;
        --ros-packages) DEV_ROS_PACKAGES="${2:-}"; DEV_ROS_PACKAGE=""; shift 2 ;;
        --builder)
          value="${2:-}"
          case "$value" in
            auto|catkin|catkin_make|colcon) DEV_ROS_BUILDER="$value" ;;
            *) dev_die "--builder must be auto, catkin, catkin_make, or colcon" ;;
          esac
          shift 2
          ;;
        --git-profile) DEV_GIT_PROFILE="${2:-}"; shift 2 ;;
        --docker-image) DEV_DOCKER_IMAGE="${2:-}"; shift 2 ;;
        --clear)
          field="${2:-}"
          case "$field" in
            workspace) DEV_ROS_WORKSPACE="" ;;
            ros-version) DEV_ROS_VERSION="" ;;
            ros-setup) DEV_ROS_SETUP="" ;;
            ros-package) DEV_ROS_PACKAGE="" ;;
            ros-packages) DEV_ROS_PACKAGES="" ;;
            builder) DEV_ROS_BUILDER="" ;;
            git-profile) DEV_GIT_PROFILE="" ;;
            docker-image) DEV_DOCKER_IMAGE="" ;;
            *) dev_die "unknown clear field: $field" ;;
          esac
          shift 2
          ;;
        -h|--help) usage; exit 0 ;;
        *) dev_die "unknown option: $1" ;;
      esac
    done
    [[ -n "$DEV_REPO" ]] || dev_die "--repo PATH is required when creating a profile"
    DEV_REPO="$(dev_expand_user_path "$DEV_REPO")"
    [[ -d "$DEV_REPO" ]] || dev_die "repository path not found: $DEV_REPO"
    git -C "$DEV_REPO" rev-parse --show-toplevel >/dev/null 2>&1 ||
      dev_die "not a Git repository: $DEV_REPO"
    DEV_REPO="$(git -C "$DEV_REPO" rev-parse --show-toplevel)"
    if [[ -n "$DEV_ROS_WORKSPACE" ]]; then
      DEV_ROS_WORKSPACE="$(dev_expand_user_path "$DEV_ROS_WORKSPACE")"
      [[ -d "$DEV_ROS_WORKSPACE" ]] || dev_die "workspace path not found: $DEV_ROS_WORKSPACE"
      DEV_ROS_WORKSPACE="$(cd "$DEV_ROS_WORKSPACE" && pwd)"
    fi
    if [[ -n "$DEV_ROS_SETUP" ]]; then
      DEV_ROS_SETUP="$(dev_expand_user_path "$DEV_ROS_SETUP")"
      [[ -f "$DEV_ROS_SETUP" ]] || dev_die "ROS setup not found: $DEV_ROS_SETUP"
    fi
    if [[ -n "$DEV_GIT_PROFILE" ]]; then
      dev_git_profile_path "$DEV_GIT_PROFILE" >/dev/null ||
        dev_die "Git identity profile not found: $DEV_GIT_PROFILE"
    fi
    write_profile "$file"
    echo "Saved project profile: $name"
    show_profile "$name"
    ;;
  *)
    dev_die "unknown command: $cmd"
    ;;
esac
